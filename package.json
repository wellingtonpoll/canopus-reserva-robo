{
  "name": "canopus-reserva-robo",
  "version": "1.0.0",
  "description": "Extensão Chrome para monitoramento e reserva automática de cotas no Portal Parceiros Canopus.",
  "main": "index.js",
  "scripts": {
    "build": "tailwindcss -i ./extension/src/input.css -o ./extension/popup.css --minify",
    "build:watch": "tailwindcss -i ./extension/src/input.css -o ./extension/popup.css --watch",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "./extension/tests/chrome-mock.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "jest": "^30.4.2",
    "tailwindcss": "^3.4.19"
  }
}
