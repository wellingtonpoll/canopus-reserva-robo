{
  "manifest_version": 3,
  "name": "Canopus Reserva Robô",
  "short_name": "Canopus Robô",
  "version": "1.4.1",
  "description": "Automatize o monitoramento e a reserva de cotas no Portal Parceiros Canopus, com notificações em tempo real via Telegram.",
  "author": "Wellington Luiz do Nascimento",
  "homepage_url": "https://github.com/wellingtonpoll/canopus-reserva-robo",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://parceiros.consorciocanopus.com.br/*",
    "https://prod-api-portalparceiro-canopus.bsn.dev.br/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://parceiros.consorciocanopus.com.br/apps/*"],
      "js": ["hydrate.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://parceiros.consorciocanopus.com.br/apps/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Canopus Reserva Robô"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
  }
}
