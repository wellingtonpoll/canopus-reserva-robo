{
  "manifest_version": 3,
  "name": "Canopus Reserva Robô",
  "version": "1.0.0",
  "description": "Monitor automático de cotas Canopus - Bypass nativo de Cloudflare Turnstile",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://parceiros.consorciocanopus.com.br/*",
    "https://prod-api-portalparceiro-canopus.bsn.dev.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}